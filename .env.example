# ==============================================================================
# Zynmail Backend (.env.example)
# Copy this file to .env and replace placeholder values with your actual config.
# DO NOT commit the .env file containing real API keys or credentials.
# ==============================================================================

# MongoDB Connection
MONGODB_URL="mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority"
DATABASE_NAME="zynmail"

# Application & CORS
APP_NAME="Zynmail"
DEBUG=true
CORS_ORIGINS="http://localhost:3000"

# AI / LLM (Groq API Key for fast classification & summaries)
# Obtain your key from https://console.groq.com/
GROQ_API_KEY="gsk_your_groq_api_key_here"

# AES-256 Fernet Encryption Key (for encrypting tokens & sensitive fields at rest)
# Generate a key using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY="your_base64_32_byte_fernet_encryption_key_here"
